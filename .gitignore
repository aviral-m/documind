.env
backend/.env
frontend/.env
frontend/.env.local

# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
